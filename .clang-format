---
# Language and Standard Rules
Language: Cpp
Standard: c++17

IndentWidth: 4
UseTab: Never

IndentCaseLabels: true
AccessModifierOffset: -4

PointerAlignment: Left
ReferenceAlignment: Left

ColumnLimit: 120

BinPackParameters: false
BinPackArguments: false

AlignAfterOpenBracket: Align

BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: false
  AfterFunction: false
  AfterControlStatement: false
  BeforeElse: false

SpaceBeforeParens: Never

SpaceBeforeAssignmentOperators: true

AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never

BreakConstructorInitializers: BeforeColon
PackConstructorInitializers: NextLine

AlignConsecutiveDeclarations: false
AlignConsecutiveAssignments: false

AlignTrailingComments: false

SpacesInConditionalStatement: false
SpacesInAngles: false

FixNamespaceComments: true

CompactNamespaces: false

SortIncludes: true
IncludeBlocks: Regroup

IncludeCategories:
  # 1. Standard C++ Library Headers (<optional>, <vector>, etc.)
  - Regex:           '^<(?!SFML\/)[^>]+>$'
    Priority:        1
    
  # 2. SFML Headers (<SFML/Graphics.hpp>, etc.)
  - Regex:           '^<SFML\/.*>$'
    Priority:        2

  # 3. Same-directory local headers (excluding the matching header)
  - Regex:           '^"([^.\/]+|\.[^\/]+)"$'
    Priority:        3

  # 4. "../" Imports (1 level up)
  - Regex:           '^"\.\.\/[^\/]+"'
    Priority:        10

  # 5. "../../" Imports (2 levels up)
  - Regex:           '^"\.\.\/\.\.\/[^\/]+"'
    Priority:        11

  # 6. "../../../" Imports (3 levels up)
  - Regex:           '^"\.\.\/\.\.\/\.\.\/[^\/]+"'
    Priority:        12

  # 7. The matching header file for this .cpp file
  - Regex:           '^"([^"]*)\.(h|hpp)"$'
    Priority:        99